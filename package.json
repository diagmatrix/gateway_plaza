{
  "name": "gateway-plaza",
  "version": "0.0.0",
  "private": true,
  "description": "Commander (EDH) game logger and stats tracker",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/diagmatrix/gateway_plaza.git"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/not-set-up.mjs dev",
    "lint": "node scripts/not-set-up.mjs lint",
    "format": "node scripts/not-set-up.mjs format",
    "format:check": "node scripts/not-set-up.mjs format:check",
    "format:files": "node scripts/not-set-up.mjs format:files",
    "typecheck": "node scripts/not-set-up.mjs typecheck",
    "test": "vitest run",
    "e2e": "node scripts/not-set-up.mjs e2e",
    "licence-check": "node scripts/licence-check.mjs",
    "notices": "node scripts/notices.mjs",
    "notices:check": "node scripts/notices.mjs --check",
    "dco-check": "node scripts/dco-check.mjs",
    "db:migrate": "node scripts/not-set-up.mjs db:migrate",
    "symbols:sync": "node scripts/not-set-up.mjs symbols:sync",
    "cards:sync": "node scripts/not-set-up.mjs cards:sync",
    "skills:install": "skills experimental_install --agent claude-code --frozen-lockfile"
  },
  "engines": {
    "node": "^26.13.1"
  },
  "packageManager": "pnpm@12.23.0+sha512.02da94ffaf133f46074322afe552f90d40b5f71ae259aefbccdacc5085b1d617e98d65e0131f5748b9b67445978ee5055d7d59a473f1eef0d504854fefcd5975",
  "devDependencies": {
    "skills": "1.9.0",
    "vitest": "5.1.2"
  }
}
