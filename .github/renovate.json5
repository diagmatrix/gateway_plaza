// SPDX-License-Identifier: AGPL-3.0-or-later
//
// Renovate keeps dependencies up to date. Update PRs are ordinary PRs, so
// they run the same CI as everyone else's, licence check and DCO check included.
// Nothing is auto-merged.
// Options: https://docs.renovatebot.com/configuration-options/
{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    // Sensible defaults, the Dependency Dashboard issue and monorepo grouping.
    'config:recommended',
    // Add a `Signed-off-by:` trailer to every commit so the DCO check passes.
    ':gitSignOff',
  ],

  // Wait before proposing a new release, so a compromised or broken publish is
  // usually caught and pulled first. Security fixes skip this wait.
  minimumReleaseAge: '3 days',

  // One weekly batch keeps the PR count low. Security fixes ignore the schedule.
  schedule: ['before 6am on monday'],

  // Raise security fix PRs from osv.dev data as well as GitHub's alerts.
  osvVulnerabilityAlerts: true,
  vulnerabilityAlerts: {
    labels: ['security'],
  },

  labels: ['dependencies'],

  // Keep pnpm-lock.yaml tidy after each update.
  postUpdateOptions: ['pnpmDedupe'],

  // Refresh transitive dependencies in the lockfile once a week.
  lockFileMaintenance: {
    enabled: true,
  },

  packageRules: [
    {
      description: 'Group all minor and patch updates into one PR',
      matchUpdateTypes: ['minor', 'patch'],
      groupName: 'minor and patch updates',
      groupSlug: 'minor-patch',
    },
    {
      description: 'Major updates get their own PR and need an explicit look at the changelog',
      matchUpdateTypes: ['major'],
      labels: ['dependencies', 'major'],
    },
  ],
}
